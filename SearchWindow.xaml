<Window x:Class="WingetInstaller.SearchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Pesquisar programas"
 Width="720" Height="520"
 WindowStartupLocation="CenterOwner"
 WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent"
 Icon="appinstall.ico"
 FontFamily="Segoe UI" FontSize="12" Foreground="#F5F7FA">

 <Window.Resources>
  <Style x:Key="RoundedButton" TargetType="Button">
   <Setter Property="Height" Value="34"/>
   <Setter Property="Padding" Value="16,5"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#117FF5"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value=".88"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".38"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
   <Setter Property="Background" Value="#1B2634"/>
   <Setter Property="Foreground" Value="#D2E0F0"/>
  </Style>

  <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
   <Setter Property="Background" Value="#223042"/>
   <Setter Property="Foreground" Value="#E4ECF6"/>
  </Style>

  <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
   <Setter Property="Background" Value="#117FF5"/>
   <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>

  <Style x:Key="JsonButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
   <Setter Property="Background" Value="#B97816"/>
   <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>

  <Style x:Key="ModernScrollBar" TargetType="{x:Type ScrollBar}">
   <Setter Property="Width" Value="5"/>
   <Setter Property="MinWidth" Value="5"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type ScrollBar}">
      <Grid Width="5" Background="Transparent">
       <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Focusable="False">
        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" BorderThickness="0"/></Track.DecreaseRepeatButton>
        <Track.Thumb>
         <Thumb MinHeight="22">
          <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#52677F" CornerRadius="2.5" Margin="1,2"/></ControlTemplate></Thumb.Template>
         </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" BorderThickness="0"/></Track.IncreaseRepeatButton>
       </Track>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>

 <Border CornerRadius="18" Background="#0C1118" BorderBrush="#263A50" BorderThickness="1.2">
  <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity=".45" Color="#000000"/></Border.Effect>
  <Grid Margin="18,12">
   <Grid.RowDefinitions>
    <RowDefinition Height="62"/>
    <RowDefinition Height="52"/>
    <RowDefinition Height="30"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="50"/>
   </Grid.RowDefinitions>

   <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="Pesquisar programas" FontSize="21" FontWeight="SemiBold"/>
     <TextBlock x:Name="LocaleText" Foreground="#8FA8C5" FontSize="11" Margin="0,3,0,0"/>
    </StackPanel>
    <Button Grid.Column="1" Content="×" Width="34" Height="30" FontSize="18"
            Foreground="White" Background="Transparent" BorderBrush="Transparent"
            BorderThickness="0" Cursor="Hand" Focusable="False"
            Click="CloseButton_Click">
     <Button.Template>
      <ControlTemplate TargetType="Button">
       <Border x:Name="CloseBorder" Background="Transparent" CornerRadius="5">
        <TextBlock Text="×" Foreground="#F4F7FB" FontSize="18"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
         <Setter TargetName="CloseBorder" Property="Background" Value="#1B2634"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
         <Setter TargetName="CloseBorder" Property="Background" Value="#263649"/>
        </Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate>
     </Button.Template>
    </Button>
   </Grid>

   <Grid Grid.Row="1" Margin="0,5,0,7">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
    <Border Background="#0B1119" BorderBrush="#30445B" BorderThickness="1" CornerRadius="9" Padding="11,0">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Text="⌕" Foreground="#7FA8D4" FontSize="18" VerticalAlignment="Center"/>
      <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
               Foreground="#F4F7FB" CaretBrush="White" VerticalContentAlignment="Center"
               FontSize="13" KeyDown="SearchBox_KeyDown"/>
     </Grid>
    </Border>
    <Button x:Name="SearchButton" Grid.Column="2" Content="Pesquisar"
            Style="{StaticResource RoundedButton}" Click="SearchButton_Click"/>
   </Grid>

   <Grid Grid.Row="2" Margin="10,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
    <TextBlock Grid.Column="1" Text="Programa" Foreground="#718EAE" FontSize="10"/>
    <TextBlock Grid.Column="2" Text="ID / Versão" Foreground="#718EAE" FontSize="10"/>
   </Grid>

   <Border Grid.Row="3" Background="#101721" CornerRadius="9" BorderBrush="#263A50" BorderThickness="1">
    <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="4">
     <ScrollViewer.Resources><Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBar}"/></ScrollViewer.Resources>
     <ItemsControl x:Name="ResultsList">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Grid Height="42" Margin="7,1">
         <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
         <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
         <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                    FontWeight="SemiBold" Foreground="#F4F7FB" TextTrimming="CharacterEllipsis"/>
         <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Id}" Foreground="#A4BCDA" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Version}" Foreground="#6F8EAF" FontSize="9.5"/>
         </StackPanel>
        </Grid>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </Border>

   <Grid Grid.Row="4" Margin="0,10,0,0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="8"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="8"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#9FB5D0"
               Text="Digite um programa para pesquisar." TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
    <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource CancelButtonStyle}" MinWidth="92" Click="CloseButton_Click"/>
    <Button x:Name="AddButton" Grid.Column="3" Content="Adicionar selecionados"
            Style="{StaticResource AddButtonStyle}" MinWidth="155"
            IsEnabled="False" Click="AddButton_Click"/>
    <Button x:Name="SaveJsonButton" Grid.Column="5" Content="Adicionar ao programas.json"
            Style="{StaticResource JsonButtonStyle}" MinWidth="178"
            IsEnabled="False" Click="SaveJsonButton_Click"/>
   </Grid>
  </Grid>
 </Border>
</Window>