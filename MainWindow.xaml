<Window x:Class="WingetInstaller.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AppInstall"
 Width="650" Height="590"
 WindowStartupLocation="CenterScreen"
 WindowStyle="None"
 ResizeMode="NoResize"
 AllowsTransparency="True"
 Background="Transparent"
 Icon="appinstall.ico"
 FontFamily="Segoe UI"
 FontSize="12"
 Foreground="#F5F7FA">

 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#121923"/>
  <SolidColorBrush x:Key="PanelBorder" Color="#2A3A4D"/>
  <SolidColorBrush x:Key="Muted" Color="#9FB5D0"/>
  <SolidColorBrush x:Key="Blue" Color="#1188FA"/>

  <Style x:Key="RoundedButton" TargetType="Button">
   <Setter Property="Height" Value="34"/>
   <Setter Property="Padding" Value="18,5"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#117FF5"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="B" Background="{TemplateBinding Background}"
              CornerRadius="9" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="B" Property="Opacity" Value=".88"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="B" Property="Opacity" Value=".72"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="B" Property="Opacity" Value=".38"/>
        <Setter Property="Cursor" Value="Arrow"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
   <Setter Property="Background" Value="#A52B38"/>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
   <Setter Property="Height" Value="31"/>
   <Setter Property="Padding" Value="12,3"/>
   <Setter Property="Background" Value="#1B2634"/>
   <Setter Property="Foreground" Value="#D2E0F0"/>
  </Style>

  <Style x:Key="ChromeButton" TargetType="Button">
   <Setter Property="Width" Value="36"/>
   <Setter Property="Height" Value="30"/>
   <Setter Property="Foreground" Value="#F3F6FA"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="19"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="B" Property="Background" Value="#243142"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- Barra de rolagem fina, sem setas e sem quadrado do tema padrão -->
  <Style x:Key="ModernScrollBar" TargetType="{x:Type ScrollBar}">
   <Setter Property="Width" Value="5"/>
   <Setter Property="MinWidth" Value="5"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type ScrollBar}">
      <Grid Width="5" Background="Transparent">
       <Track x:Name="PART_Track" Orientation="Vertical"
              IsDirectionReversed="True" Focusable="False">
        <Track.DecreaseRepeatButton>
         <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                       Background="Transparent" BorderThickness="0" Opacity="0"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
         <Thumb MinHeight="22">
          <Thumb.Template>
           <ControlTemplate TargetType="Thumb">
            <Border Background="#52677F" CornerRadius="2.5" Margin="1,2"/>
           </ControlTemplate>
          </Thumb.Template>
         </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
         <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                       Background="Transparent" BorderThickness="0" Opacity="0"/>
        </Track.IncreaseRepeatButton>
       </Track>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

 </Window.Resources>

 <Border CornerRadius="18"
         Background="#0C1118"
         BorderBrush="#263A50"
         BorderThickness="1.2">
  <Border.Effect>
   <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity=".45" Color="#000000"/>
  </Border.Effect>

  <Grid Margin="16,10,16,10">
   <Grid.RowDefinitions>
    <RowDefinition Height="82"/>
    <RowDefinition Height="192"/>
    <RowDefinition Height="27"/>
    <RowDefinition Height="36"/>
    <RowDefinition Height="142"/>
    <RowDefinition Height="48"/>
    <RowDefinition Height="43"/>
   </Grid.RowDefinitions>

   <!-- One single header. Entire empty/header region is draggable. -->
   <Grid Grid.Row="0" Background="Transparent"
         MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="54"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <Border Width="44" Height="44" CornerRadius="10" Background="#1188FA"
            HorizontalAlignment="Left" VerticalAlignment="Center">
     <Grid>
      <TextBlock Text="↓" Foreground="White" FontSize="29" FontWeight="Bold"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-7,0,0"/>
      <Border Width="20" Height="4" CornerRadius="2" Background="White"
              VerticalAlignment="Bottom" Margin="0,0,0,9"/>
     </Grid>
    </Border>

    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="App" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
      <TextBlock Text="Install" FontSize="24" FontWeight="SemiBold" Foreground="#1188FA"/>
      <Border Background="#222D3C" CornerRadius="6" Margin="10,5,0,0"
              Padding="8,3" VerticalAlignment="Top">
       <TextBlock Text="1.0 build 45" Foreground="#D1DEEC" FontSize="11"/>
      </Border>
     </StackPanel>
     <TextBlock Text="Instale e mantenha seus programas atualizados"
                Foreground="#A9BDD6" FontSize="12" Margin="1,-2,0,0"/>
    </StackPanel>

    <Grid Grid.Column="2" VerticalAlignment="Stretch">
     <TextBlock Text="Simples. Atualizado. Sempre."
                Foreground="#B9CBE1" FontStyle="Italic" FontSize="12"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,20,0,0"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button Content="−" Style="{StaticResource ChromeButton}" Click="MinimizeButton_Click"/>
      <Button Content="×" Style="{StaticResource ChromeButton}" Click="CloseButton_Click"/>
     </StackPanel>
    </Grid>
   </Grid>

   <!-- Lista principal. A pesquisa abre em uma janela separada. -->
   <Border Grid.Row="1" Background="#121923" CornerRadius="10"
           BorderBrush="#2A3A4D" BorderThickness="1.2">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="38"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>

     <Grid Margin="10,4,10,3">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="6"/>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="6"/>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="6"/>
       <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Text="Programas selecionados"
                 Foreground="#A9BDD6"
                 FontSize="11"
                 VerticalAlignment="Center"/>

      <Button x:Name="SelectAllButton"
              Grid.Column="2"
              Content="☑ Todos"
              Style="{StaticResource GhostButton}"
              Height="24"
              MinWidth="62"
              Padding="8,1"
              FontSize="10"
              IsEnabled="False"
              ToolTip="Selecionar todos ou limpar a seleção"
              Click="SelectAllButton_Click"/>

      <Button x:Name="WingetButton"
              Grid.Column="4"
              Content="Verificando WinGet..."
              Style="{StaticResource GhostButton}"
              MinWidth="112"
              IsEnabled="False"
              ToolTip="Verificar ou instalar o Windows Package Manager"
              Click="WingetButton_Click"/>

      <Button x:Name="RefreshVersionsButton"
              Grid.Column="6"
              Content="↻ Verificar"
              Style="{StaticResource GhostButton}"
              Height="28"
              MinWidth="78"
              Padding="9,2"
              FontSize="10.5"
              IsEnabled="False"
              ToolTip="Verificar novamente versões e atualizações"
              Click="RefreshVersionsButton_Click"/>

      <Button x:Name="OpenSearchButton"
              Grid.Column="8"
              Content="⌕  Pesquisar programa"
              Style="{StaticResource GhostButton}"
              Click="OpenSearchButton_Click"/>
     </Grid>

     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible"
                   HorizontalScrollBarVisibility="Disabled">
      <ScrollViewer.Resources>
       <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBar}"/>
      </ScrollViewer.Resources>
      <ItemsControl x:Name="ProgramsList">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Grid Height="31" Margin="10,0">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/>
           <ColumnDefinition Width="185"/><ColumnDefinition Width="98"/>
           <ColumnDefinition Width="36"/><ColumnDefinition Width="32"/>
          </Grid.ColumnDefinitions>
          <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                    Tag="{Binding}"
                    Click="ProgramCheckBox_Click"
                    VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                     VerticalAlignment="Center" Foreground="#F4F7FB"/>
          <TextBlock Grid.Column="2" Text="{Binding VersionText}" VerticalAlignment="Center"
                     Foreground="#A4BCDA" TextTrimming="CharacterEllipsis"/>
          <Border Grid.Column="3" Background="#1D2836" CornerRadius="7" Padding="9,5"
                  HorizontalAlignment="Right" VerticalAlignment="Center">
           <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}"/>
          </Border>

          <Button Grid.Column="4" Width="28" Height="24"
                  ToolTip="Remover do programas.json"
                  Visibility="{Binding JsonButtonVisibility}"
                  Tag="{Binding}" Click="RemoveFromJsonButton_Click"
                  Background="Transparent" BorderThickness="0" Padding="0"
                  Cursor="Hand" Focusable="False"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
           <Button.Template>
            <ControlTemplate TargetType="Button">
             <Border x:Name="JsonBorder" Background="Transparent" CornerRadius="6"
                     SnapsToDevicePixels="True">
              <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,-1,0,0">
               <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
               </Grid.ColumnDefinitions>
               <TextBlock Grid.Column="0" Text="{}" Foreground="#F2B35E"
                          FontSize="9" FontWeight="SemiBold"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
               <TextBlock Grid.Column="1" Text="×" Foreground="#F2B35E"
                          FontSize="17" FontWeight="SemiBold"
                          Margin="1,0,0,0"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          TextAlignment="Center"/>
              </Grid>
             </Border>
             <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
               <Setter TargetName="JsonBorder" Property="Background" Value="#3A2D1D"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
               <Setter TargetName="JsonBorder" Property="Background" Value="#554022"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
               <Setter TargetName="JsonBorder" Property="Opacity" Value=".3"/>
              </Trigger>
             </ControlTemplate.Triggers>
            </ControlTemplate>
           </Button.Template>
          </Button>

          <Button Grid.Column="5" Width="24" Height="24"
                  ToolTip="Remover da lista"
                  Tag="{Binding}" Click="RemoveProgramButton_Click"
                  Background="Transparent" BorderThickness="0" Padding="0"
                  Cursor="Hand" Focusable="False"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
           <Button.Template>
            <ControlTemplate TargetType="Button">
             <Border x:Name="RemoveBorder" Background="Transparent" CornerRadius="6"
                     SnapsToDevicePixels="True">
              <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,-1,0,0">
               <TextBlock Text="×" Foreground="#FF5A67" FontSize="17"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          TextAlignment="Center"/>
              </Grid>
             </Border>
             <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
               <Setter TargetName="RemoveBorder" Property="Background" Value="#382027"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
               <Setter TargetName="RemoveBorder" Property="Background" Value="#54252D"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
               <Setter TargetName="RemoveBorder" Property="Opacity" Value=".3"/>
              </Trigger>
             </ControlTemplate.Triggers>
            </ControlTemplate>
           </Button.Template>
          </Button>
         </Grid>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </Grid>
   </Border>

   <Grid Grid.Row="2" Margin="0,4,0,1">
    <Border HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Height="22"
            Padding="8,0"
            CornerRadius="11"
            Background="#151F2B"
            BorderBrush="#2B3B4F"
            BorderThickness="1">
     <StackPanel Orientation="Horizontal"
                 VerticalAlignment="Center">
      <TextBlock Text="▦"
                 Foreground="#6DAFFF"
                 FontSize="10"
                 Margin="0,0,5,0"
                 VerticalAlignment="Center"/>
      <TextBlock x:Name="ProgressText"
                 Text="0 programas"
                 Foreground="#B6C9E1"
                 FontSize="10.5"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"/>
     </StackPanel>
    </Border>
   </Grid>

   <Grid Grid.Row="3">
    <Grid.ColumnDefinitions>
     <ColumnDefinition/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="28" Height="28" CornerRadius="6"
             Background="#192534" Margin="0,0,9,0">
      <TextBlock Text="&gt;_" Foreground="#A6CEF8"
                 FontFamily="Consolas" FontSize="11"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="Log da instalação" VerticalAlignment="Center"
                Foreground="#E2EBF6" FontSize="13"/>
    </StackPanel>
    <Button x:Name="ClearLogButton" Grid.Column="1"
            Content="Limpar log" Style="{StaticResource GhostButton}"
            Click="ClearLogButton_Click"/>
   </Grid>

   <Border Grid.Row="4" Background="#06090D" CornerRadius="9"
           BorderBrush="#2A3A4D" BorderThickness="1.2">
    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Disabled"
             Background="Transparent" Foreground="#DCE9F8"
             BorderThickness="0" FontFamily="Consolas"
             FontSize="10.5" Padding="10">
     <TextBox.Resources>
      <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBar}"/>
     </TextBox.Resources>
    </TextBox>
   </Border>

   <Grid Grid.Row="5" Margin="0,10,0,0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="5"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="5"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="5"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="5"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="5"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="10"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Button x:Name="InstallButton"
            Content="▶  Instalar"
            Style="{StaticResource RoundedButton}"
            Height="30"
            MinWidth="94"
            Padding="13,3"
            Click="InstallButton_Click"
            IsEnabled="False"/>

    <Button x:Name="SelectUpdatesButton"
            Grid.Column="2"
            Content="☑ Atualizações (0)"
            Style="{StaticResource GhostButton}"
            Height="28"
            MinWidth="104"
            Padding="9,2"
            FontSize="10.5"
            IsEnabled="False"
            ToolTip="Selecionar somente programas instalados que possuem atualização"
            Click="SelectUpdatesButton_Click"/>

    <Button x:Name="SelectMissingButton"
            Grid.Column="4"
            Content="＋ Não instalados (0)"
            Style="{StaticResource GhostButton}"
            Height="28"
            MinWidth="110"
            Padding="9,2"
            FontSize="10.5"
            IsEnabled="False"
            ToolTip="Selecionar somente programas que ainda não estão instalados"
            Click="SelectMissingButton_Click"/>

    <Button x:Name="UpdateAllButton"
            Grid.Column="6"
            Content="↻ Atualizar (0)"
            Style="{StaticResource GhostButton}"
            Height="28"
            MinWidth="88"
            Padding="9,2"
            FontSize="10.5"
            Click="UpdateAllButton_Click"
            IsEnabled="False"/>

    <Button x:Name="RetryFailuresButton"
            Grid.Column="8"
            Content="↻ Falhas"
            Style="{StaticResource GhostButton}"
            Height="28"
            MinWidth="74"
            Padding="9,2"
            FontSize="10.5"
            Click="RetryFailuresButton_Click"
            Visibility="Collapsed"
            IsEnabled="False"/>

    <Button x:Name="CancelButton"
            Grid.Column="10"
            Content="■ Cancelar"
            Style="{StaticResource CancelButtonStyle}"
            Height="30"
            MinWidth="72"
            Padding="10,3"
            Click="CancelButton_Click"
            IsEnabled="False"/>

    <TextBlock x:Name="FooterStatus"
               Grid.Column="12"
               Width="0"
               Height="0"
               Visibility="Collapsed"
               Text=""/>
   </Grid>

   <Grid Grid.Row="6">
    <Border Height="1" Background="#2A3A4D" VerticalAlignment="Top"/>
    <Grid Margin="0,10,0,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="⌂" FontSize="15" Foreground="#7890AC" Margin="0,0,7,0"/>
      <TextBlock Text="App" FontWeight="SemiBold" Foreground="White"/>
      <TextBlock Text="Install" FontWeight="SemiBold" Foreground="#1188FA"/>
      <TextBlock Text="  |  Utilitários essenciais para Windows"
                 Foreground="#7890AC" FontSize="10"/>
     </StackPanel>
     <TextBlock Grid.Column="1"
                Text="Desenvolvido por PHVR  |  © 2026  |  Todos os direitos reservados"
                Foreground="#7890AC"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                FontSize="9"/>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>